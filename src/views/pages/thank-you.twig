{#
| Variable            | Type   | Description                            |
|---------------------|--------|----------------------------------------|
| page                | object |                                        |
| page.title          | string |                                        |
| page.slug           | string |                                        |
| order               | Order  | @see pages/customer/orders/single.twig |
| thank_you_title     | string | merchant customized main text          |
| share_message       | string |                                        |
| short_share_message | string |                                        |

Fulfilment section is picked from order state:
 - pickup (order.is_pickable)  -> <salla-order-branch items sticky-cta> (items card + branch details footer)
 - delivery (single or split)  -> <salla-order-shipments sticky-cta> (one card per shipment, bottom sheet for split)
Digital orders are out of scope here (they are redirected to the order summary page by the backend).

The fulfilment CTA lives inside those components: on desktop it renders in-flow above the cards
(as in the design), on mobile it is the sticky bottom bar.
#}
{% extends "layouts.master" %}

{% block content %}
    {% hook 'thank-you:start' %}
    <div class="container">
        <div class="thank-you-content mx-auto flex w-full max-w-[800px] flex-col gap-6 py-8">
        {# Header + fulfilment + payment share the design's 12px rhythm #}
        <div class="flex flex-col gap-3">
            {# Header: merchant main/subtext (Header Customization story), order number, date & time #}
            <header class="thank-you-header flex w-full flex-col items-center gap-3 text-center">
                <div class="flex w-full flex-col items-center gap-3">
                    <span class="relative flex items-center justify-center w-16 h-16 rounded-full text-primary-reverse">
                        <img src="{{ 'images/thank-you/success.svg'|asset }}" alt="" class="absolute -inset-px max-w-none" width="66" height="66">
                        <span class="absolute bottom-px right-px flex items-center justify-center w-6 h-6 overflow-hidden rounded-full border border-white bg-white p-1 text-primary">
                            {% if store.logo %}
                                <img src="{{ store.logo|cdn(48, 48) }}" alt="{{ store.name }}" class="w-full h-full object-contain" loading="lazy">
                            {% else %}
                                <i class="sicon-store text-xs"></i>
                            {% endif %}
                        </span>
                    </span>
                    <div class="flex w-full flex-col gap-1">
                    <h1 data-testid="store-thankyou-title" class="m-0 text-xl font-bold leading-7 text-[#333]">{{ thank_you_title }}</h1>
                    <p class="m-0 w-full text-sm leading-5 text-[#666]">{{ thank_you_subtitle ?? trans('pages.thank_you.order_received') }}</p>
                    </div>
                </div>

                <hr class="w-full border-0 border-t border-[#f4f4f4]">

                <div class="flex w-full flex-wrap items-center justify-center gap-x-6 gap-y-1 text-xs leading-4 text-[#666]">
                    <button type="button" data-testid="store-thankyou-order-id" class="inline-flex items-center gap-1"
                            aria-label="{{ trans('common.elements.copy') }} {{ order.reference_id }}" data-copy-order="{{ order.reference_id }}">
                        <img src="{{ 'images/thank-you/order.svg'|asset }}" width="14" height="14" alt="" class="pointer-events-none">
                        <span class="pointer-events-none" dir="ltr">#{{ order.reference_id }}</span>
                        <img src="{{ 'images/thank-you/copy.svg'|asset }}" width="14" height="14" alt="" class="pointer-events-none">
                    </button>
                    <span class="inline-flex items-center gap-1">
                        <img src="{{ 'images/thank-you/time.svg'|asset }}" width="14" height="14" alt="">
                        <time data-thankyou-date datetime="{{ order.created_at|date('c') }}">{{ order.created_at|date('Y/m/d - h:i A')|number }}</time>
                    </span>
                </div>

                {% if order.instructions %}
                    <article class="article article--main article--small text-center">{{ order.instructions|raw }}</article>
                {% endif %}
                {% for message in messages %}
                    <span class="font-bold">{{ message }}</span>
                {% endfor %}
            </header>

            {# Items list + tracking / pickup info #}
            {% hook 'thank-you:items.start' %}
            {% if order.is_pickable %}
                <salla-order-branch data-testid="store-thankyou-branch" items="{{ order.items|json_encode }}" sticky-cta></salla-order-branch>
            {% else %}
                <salla-order-shipments data-testid="store-thankyou-shipments" class="empty:hidden" sticky-cta></salla-order-shipments>
            {% endif %}
            {% hook 'thank-you:items.end' %}

            {# Payment #}
            <section data-testid="store-thankyou-payment" class="flex w-full flex-col items-end gap-3 rounded-lg border border-[#f4f4f4] bg-white p-3">
                <dl class="flex w-full flex-col gap-2">
                    <div class="flex w-full items-center gap-4">
                        <dt class="flex-1 text-start text-xs leading-4 text-[#666]">{{ trans('pages.cart.payment_way') }}</dt>
                        <dd class="m-0 flex items-center">
                            <img src="{{ ('images/payment/' ~ order.payment_method ~ '_mini.png')|cdn(58, 58) }}" alt="{{ order.payment_method }}" class="h-4 w-auto" loading="lazy" onerror="this.remove()">
                        </dd>
                    </div>
                    <div class="flex w-full items-start gap-4">
                        <dt class="flex-1 text-start text-xs leading-4 text-[#666]">{{ trans('pages.cart.items_total') }}</dt>
                        <dd class="m-0 text-xs leading-4 text-[#666]">{{ order.sub_total|money }}</dd>
                    </div>
                    {% if order.tax %}
                        <div class="flex w-full items-start gap-4">
                            <dt class="flex-1 text-start text-xs leading-4 text-[#666]">{{ trans('pages.cart.tax') }}</dt>
                            <dd class="m-0 text-xs leading-4 text-[#666]">{{ order.tax.amount|money }}</dd>
                        </div>
                    {% endif %}
                    {% if order.shipping_cost %}
                        <div class="flex w-full items-start gap-4">
                            <dt class="flex-1 text-start text-xs leading-4 text-[#666]">{{ trans('pages.orders.shipping_cost') }}</dt>
                            <dd class="m-0 text-xs leading-4 text-[#666]">{{ order.shipping_cost|money }}</dd>
                        </div>
                    {% endif %}
                    <div class="flex w-full items-start gap-4">
                        <dt class="flex-1 text-start text-sm font-bold leading-5 text-[#333]">{{ trans('pages.orders.final_total') }}</dt>
                        <dd class="m-0 text-sm font-bold leading-5 text-[#333]">{{ order.total|money }}</dd>
                    </div>
                </dl>
                <a href="{{ order.print_url }}" target="_blank" rel="noopener" data-testid="store-thankyou-order-details-btn"
                        class="flex h-10 w-full items-center justify-center gap-2 rounded-lg border border-[#eee] text-sm font-medium text-[#333] no-underline">
                    <i class="sicon-receipt text-base leading-none"></i>
                    {{ trans('pages.thank_you.view_invoice') }}
                </a>
            </section>
        </div>

        {# Merchant custom component after the payment section (Custom Component story) #}
        {% hook 'thank-you:payment.end' %}

        {# Rewards actually earned on this order. #}
        {% if order.cashback or order.loyalty_points %}
            <div data-testid="store-thankyou-rewards" class="flex w-full flex-wrap items-stretch gap-2">
                {% if order.loyalty_points %}
                    <a href="{{ link('loyalty') }}"
                       class="flex flex-1 min-w-0 items-center gap-2 rounded-lg bg-[#effbf6] px-4 py-3 no-underline">
                        <span class="flex min-w-0 flex-1 items-center gap-2">
                            <img src="{{ 'images/thank-you/stars.svg'|asset }}" width="24" height="24" alt="" class="shrink-0">
                            <span class="flex min-w-0 flex-1 flex-col items-start">
                                <b class="text-sm font-bold leading-5 text-[#008c56]">+{{ order.loyalty_points|number }}</b>
                                <span class="truncate text-xs leading-4 text-[#666]">{{ trans('pages.thank_you.loyalty_points') }}</span>
                            </span>
                        </span>
                        <img src="{{ 'images/thank-you/arrow.svg'|asset }}" width="16" height="16" alt="" class="shrink-0 ltr:rotate-180">
                    </a>
                {% endif %}
                {% if order.cashback %}
                    <a href="{{ order.cashback.url }}"
                       class="flex flex-1 min-w-0 items-center gap-2 rounded-lg bg-[#effbf6] px-4 py-3 no-underline">
                        <span class="flex min-w-0 flex-1 items-center gap-2">
                            <img src="{{ 'images/thank-you/gift.svg'|asset }}" width="24" height="24" alt="" class="shrink-0">
                            <span class="flex min-w-0 flex-1 flex-col items-start">
                                <b class="text-sm font-bold leading-5 text-[#008c56]">{{ order.cashback.amount|money }}</b>
                                <span class="truncate text-xs leading-4 text-[#666]">{{ trans('pages.thank_you.cashback') }}</span>
                            </span>
                        </span>
                        <img src="{{ 'images/thank-you/arrow.svg'|asset }}" width="16" height="16" alt="" class="shrink-0 ltr:rotate-180">
                    </a>
                {% endif %}
            </div>

            <hr class="w-full border-0 border-t border-[#f4f4f4]">
        {% endif %}

        {# Gifts: tinted container + one card per thank-you coupon #}
        <salla-next-order-coupon data-testid="store-thankyou-coupon"></salla-next-order-coupon>

        {# Contact channels (Contact Channels Customization story decides which ones) #}
        <section class="flex w-full flex-col items-center gap-3 text-center">
            <p class="m-0 text-sm leading-5 text-[#666]">{{ trans('pages.thank_you.contact_us') }}</p>
            <salla-contacts data-testid="store-thankyou-contacts" class="flex justify-center" hide-title horizontal icons-only></salla-contacts>
        </section>

        {% hook 'thank-you:end' %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
