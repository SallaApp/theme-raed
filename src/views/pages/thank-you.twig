{#
| Variable            | Type   | Description                            |
|---------------------|--------|----------------------------------------|
| page                | object |                                        |
| page.title          | string |                                        |
| page.slug           | string |                                        |
| order               | Order  | @see pages/customer/orders/single.twig |
| thank_you_title     | string | merchant customized main text          |
| share_message       | string |                                        |
| short_share_message | string |                                        |

Fulfilment section is picked from order state:
 - pickup (order.is_pickable)  -> <salla-order-items> + <salla-order-branch sticky-cta>
 - delivery (single or split)  -> <salla-order-shipments sticky-cta> (one card per shipment, bottom sheet for split)
Digital orders are out of scope here (they are redirected to the order summary page by the backend).
#}
{% extends "layouts.master" %}

{% block content %}
    {% hook 'thank-you:start' %}
    <div class="container max-w-3xl mb-24 md:mb-12 space-y-4">
        {# Header: merchant main/subtext (Header Customization story), order number, date & time #}
        <header class="flex flex-col items-center text-center pt-10 pb-4 gap-2">
            <span class="thanks-item opacity-0 flex items-center justify-center w-16 h-16 rounded-full bg-primary text-primary-reverse mb-4">
                <i class="sicon-check text-3xl"></i>
            </span>
            <h1 data-testid="store-thankyou-title" class="thanks-item opacity-0 font-bold text-xl">{{ thank_you_title }}</h1>
            <p class="thanks-item opacity-0 text-gray-500 text-sm">{{ thank_you_subtitle ?? trans('pages.thank_you.order_received') }}</p>

            <div class="thanks-item opacity-0 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-gray-500 mt-2">
                <salla-button data-testid="store-thankyou-order-id" onclick="app.copyToClipboard(event)" color="dark" shape="link" size="small" data-content="{{ order.reference_id }}">
                    <i class="sicon-swap-stroke pointer-events-none"></i>
                    <span>#{{ order.reference_id }}</span>
                </salla-button>
                <span class="inline-flex items-center gap-1">
                    <i class="sicon-clock"></i>
                    <span>{{ order.created_at|date('Y/m/d - h:i A')|number }}</span>
                </span>
            </div>

            {% if order.instructions %}
                <article class="article article--main article--small text-center">{{ order.instructions|raw }}</article>
            {% endif %}
            {% for message in messages %}
                <span class="font-bold">{{ message }}</span>
            {% endfor %}
        </header>

        {# Items list + tracking / pickup info #}
        {% hook 'thank-you:items.start' %}
        {% if order.is_pickable %}
            <salla-order-items data-testid="store-thankyou-items"
                               items="{{ order.items|json_encode }}"
                               card-title="{{ trans('pages.checkout.pickup_option') }}"></salla-order-items>
            <salla-order-branch data-testid="store-thankyou-branch" stack-cards sticky-cta></salla-order-branch>
        {% else %}
            <salla-order-shipments data-testid="store-thankyou-shipments" class="block empty:hidden" sticky-cta></salla-order-shipments>
        {% endif %}
        {% hook 'thank-you:items.end' %}

        {# Payment #}
        <section data-testid="store-thankyou-payment" class="bg-white rounded-md border border-gray-100 p-4 space-y-3 text-sm">
            <dl class="space-y-2">
                <div class="flex items-center justify-between gap-2">
                    <dt class="text-gray-500">{{ trans('pages.cart.payment_way') }}</dt>
                    <dd class="flex items-center gap-1">
                        <img src="{{ ('images/payment/' ~ order.payment_method ~ '_mini.png')|cdn(58, 58) }}" alt="{{ order.payment_method }}" class="h-6 w-auto" loading="lazy" onerror="this.remove()">
                    </dd>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <dt class="text-gray-500">{{ trans('pages.cart.items_total') }}</dt>
                    <dd>{{ order.sub_total|money }}</dd>
                </div>
                {% if order.tax %}
                    <div class="flex items-center justify-between gap-2">
                        <dt class="text-gray-500">{{ trans('pages.cart.tax') }}</dt>
                        <dd>{{ order.tax.amount|money }}</dd>
                    </div>
                {% endif %}
                {% if order.shipping_cost %}
                    <div class="flex items-center justify-between gap-2">
                        <dt class="text-gray-500">{{ trans('pages.orders.shipping_cost') }}</dt>
                        <dd>{{ order.shipping_cost|money }}</dd>
                    </div>
                {% endif %}
                <div class="flex items-center justify-between gap-2 font-bold">
                    <dt>{{ trans('pages.orders.final_total') }}</dt>
                    <dd>{{ order.total|money }}</dd>
                </div>
            </dl>
            <salla-button data-testid="store-thankyou-order-details-btn" fill="outline" width="wide"
                          onclick="salla.order.show({order_id:'{{ order.id }}', url:'{{ order.url }}'})">
                <i class="sicon-newspaper rtl:ml-1 ltr:mr-1"></i>
                {{ trans('pages.thank_you.order_details') }}
            </salla-button>
        </section>

        {# Merchant custom component after the payment section (Custom Component story) #}
        {% hook 'thank-you:payment.end' %}

        {# Loyalty points & cashback box: rendered here once the Loyalty & Cashback Settings story lands #}

        <salla-next-order-coupon data-testid="store-thankyou-coupon"></salla-next-order-coupon>

        {# Contact channels (Contact Channels Customization story decides which ones) #}
        <section class="text-center space-y-3 pt-4">
            <p class="text-sm">{{ trans('blocks.footer.social') }}</p>
            <salla-contacts data-testid="store-thankyou-contacts" class="flex justify-center" hide-title horizontal icons-only></salla-contacts>
        </section>

        {% hook 'thank-you:end' %}
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
