{#
| Variable                 | Type      | Description                                                         |
|--------------------------|-----------|---------------------------------------------------------------------|
| items                    | array     |                                                                     |
| items[].title            | string    | Section title                                                       |
| items[].name             | string    | Alias for title                                                     |
| items[].type             | string    | category,most_sales,latest_products,chosen_products                 |
| items[].featured_product | Null      |                                                                     |
| items[].products[]       | Product[] |                                                                     |
| items[].limit            | Int       | Number of products to be shown                                      |
| items[].id               | string    | Section id                                                          |
| items[].products.source        | ?string   | When set, fetch the tab client-side (salla-products-list)           |
| items[].products.source_value  | ?array    | Ids/values for products.source                                      |
| items[].featured_product_id    | ?string   | Present only when products come as source + source_value            |
| main_product             | array     |                                                                     |
| main_product.id          | string    | string product id                                                   |
| main_product.title       | string    | Offer title                                                         |
| main_product.value       | string    | Product Name                                                        |
| main_product.product     | Product   |                                                                     |
| main_product.product_id  | ?string   | When set, the card fetches the product by id                        |
| position                 | int       | sorting block                                                       |
#}
{% set component_id='featured-products-style1-' ~ position %}
<section component-id="{{ componentId }}" data-testid="store-home-featured-products" class="s-block s-block-tabs s-block--special-products container" id="{{ component_id }}">
    <div class="s-block__title"> 
      <div class="right-side">
        <h2>{{ main_product.title }}</h2>
      </div>
      {% if items|length > 1 %}
      <div class="tabs hide-scroll hidden lg:flex">
          {% for section in items %}
              <salla-button shape="link"
                      data-target="{{ component_id }}-{{ section.id }}"
                      data-component-id="{{ component_id }}"
                      class="tab-trigger {{ loop.first?'is-active' : '' }}">
                  {{ section.title }}
              </salla-button>
          {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 {{ main_product?'lg:grid-cols-2':''}} gap-8">
        {% if main_product %}
            <div class="flex flex-col">
                {% if main_product.product_id is defined %}
                    <custom-salla-product-card shadow-on-hover product-id="{{ main_product.product_id }}" isSpecial></custom-salla-product-card>
                {% else %}
                    <custom-salla-product-card shadow-on-hover product="{{main_product.product}}" isSpecial></custom-salla-product-card>
                {% endif %}
            </div>
        {% endif %}
        <div class="flex flex-col">
            {% if items|length > 1 %}
            <div class="tabs mb-4 sm:mb-8 hide-scroll lg:hidden">
                {% for section in items %}
                    <salla-button shape="link"
                            data-target="{{ component_id }}-{{ section.id }}"
                            data-component-id="{{ component_id }}"
                            class="tab-trigger {{ loop.first?'is-active':'' }}">
                        {{ section.title }}
                    </salla-button> 
                {% endfor %}
            </div>
            {% endif %}

            <div class="tabs-wrapper flex flex-1">
                {% for section in items %}
                    {# products.source cannot be the switch: on a CollectionPresenter Twig resolves any key through __call #}
                    {% if section.featured_product_id is defined %}
                        <div id="{{ component_id }}-{{ section.id }}" class="tabs__item {{ loop.first?'is-active':'' }}">
                            <salla-products-list
                              source="{{ section.products.source }}"
                              limit="{{ main_product?4:8 }}"
                              source-value="{{ section.products.source_value|json_encode }}">
                            </salla-products-list>
                        </div>
                    {% else %}
                        <div id="{{ component_id }}-{{ section.id }}" class="tabs__item grid-cols-2 {{ main_product?'':'lg:grid-cols-4'}} {{ loop.first?'is-active':'' }}">
                            {% for product in section.products|slice(0,main_product?4:8) %}
                                <custom-salla-product-card product="{{product}}"></custom-salla-product-card>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</section> 
