{#
| Variable        | Type       | Description                    |
|-----------------|------------|--------------------------------|
| products        | Products[] |                                |
| position        | Int        | Sorting number start from zero |
#}
<section component-id="{{ componentId }}" data-testid="store-home-products-section" class="s-block s-block--latest-products container mt-6 sm:mt-8">
    <div class="s-block__title">
      <h2>{{ trans('blocks.home.latest_products') }}</h2>
    </div>
    
    <div class="products-reserve">
      {% include 'pages.partials.product.skeleton' with { type: 'grid', count: 8 } %}
      <salla-products-list data-testid="store-home-latest-products-list" source="latest"></salla-products-list>
    </div>
</section> 
