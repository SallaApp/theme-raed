{#
| Variable          | Type   | Description                                                      |
|-------------------|--------|------------------------------------------------------------------|
| title             | string | Section title                                                    |
| items[]           | array  | List of images                                                   |
| items[].url       | Bool   | Should set overlay on the background or not                      |
| items[].link_type | string | category,product,offers,page,external_link,brand                 |
| items[].image.url | string |                                                                  |
| items[].image.alt | string |                                                                  |
| items[].text      | string | Visible title for the photo                                      |
| position          | Int    | Sorting number start from zero                                   |
#}
{% set photos_count = items|length %}
{% set equal_size = theme.settings.get('square_photos_equal_size') %}
{% set photos_grid = 'square-photos-grid grid grid-flow-row gap-3 sm:gap-8' %}
{% set use_mosaic = not equal_size and photos_count is odd and photos_count > 1 %}
{% if use_mosaic %}
    {% set photos_grid = photos_grid ~ (photos_count <= 3 ? ' square-photos-grid--mosaic-3' : ' square-photos-grid--mosaic-5') %}
{% elseif photos_count is even %}
    {% set photos_grid = photos_grid ~ (photos_count <= 4 ? ' md:grid-cols-2' : ' md:grid-cols-3') %}
{% elseif photos_count >= 3 %}
    {% set photos_grid = photos_grid ~ ' md:grid-cols-3' %}
{% endif %}
<section component-id="{{ componentId }}" data-testid="store-home-square-photos" class="s-block s-block--banners container">
    {% if title %}
        <div class="s-block__title">
            <div class="right-side">
                <h2>{{ title }}</h2>
            </div>
        </div>
    {% endif %}

    <div class="{{ photos_grid }}">
        {% for item in items %}
            <a class="banner-entry square-photos {{ item.text ? 'has-overlay with-hover' : '' }}" href="{{ item.url }}" {% if item.link_type == 'external_link' %}target="_blank"{% endif %}>
                <div class="lazy__bg lazy bg-no-repeat" data-bg="{{ item.image.url }}"
                style="background-size: {{ theme.settings.get('squar_photo_bg_image_size', 'contain') }};"
                ></div>
                {% if item.text %}
                        <h3 class="text-with-border"><span>{{ item.text }}</span></h3> 
                {% endif %}
            </a>
        {% endfor %}
    </div>
</section>
