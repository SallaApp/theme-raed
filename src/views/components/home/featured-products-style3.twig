{#
| Variable                      | Type      | Description                                                         |
|-------------------------------|-----------|---------------------------------------------------------------------|
| items                         | array     |                                                                     |
| items[].title                 | string    | Section title                                                       |
| items[].name                  | string    | Alias for title                                                     |
| items[].type                  | string    | category,most_sales,latest_products,chosen_products                 |
| items[].featured_product      | Product   |                                                                     |
| items[].special_product.id    | string    | Product string id                                                   |
| items[].special_product.title | string    | Product Name                                                        |
| items[].products[]            | Product[] |                                                                     |
| items[].limit                 | Int       | Number of products to be shown                                      |
| items[].id                    | string    | Section id                                                          |
| items[].products.source        | ?string   | When set, fetch the tab client-side (salla-products-list)           |
| items[].products.source_value  | ?array    | Ids/values for products.source                                      |
| items[].featured_product_id   | ?string   | When set, the card fetches the featured product by id               |
| position                      | int       | Sorting number starts from zero                                     |
#}
<section component-id="{{ componentId }}" data-testid="store-home-featured-products-grid" class="s-block s-block--features-products {% if items | length > 1 %}two-cols{% endif %} container">
    <div class="inner">
        {% for section in items %}
            <div>
                <div class="s-block__title">
                  <h2>{{ section.title }}</h2>
                  {# <p>عنوان فرعي توصيفي صغير</p> #}
                </div> 
                <div class="flex-1 grid lg:grid-cols-2 gap-4 sm:gap-8">
                    {# products.source cannot be the switch: on a CollectionPresenter Twig resolves any key through __call #}
                    {% if section.featured_product_id is defined %}
                        {% if section.featured_product_id %}
                            <custom-salla-product-card shadow-on-hover product-id="{{ section.featured_product_id }}" fullImage></custom-salla-product-card>
                        {% endif %}
                        <salla-products-list
                          data-product-card-minimal
                          class="{{ section.featured_product_id ? '' : 'lg:col-span-2' }}"
                          source="{{ section.products.source }}"
                          limit="{{ section.featured_product_id ? 3 : section.products.limit }}"
                          source-value="{{ section.products.source_value|json_encode }}">
                        </salla-products-list>
                    {% elseif section.featured_product %}
                        <custom-salla-product-card shadow-on-hover product="{{section.featured_product}}" fullImage></custom-salla-product-card>
                        <div class="grid gap-4 sm:gap-8">
                            {% for product in section.products|slice(0,3) %}
                                <custom-salla-product-card shadow-on-hover product="{{product}}" minimal></custom-salla-product-card>
                            {% endfor %}
                        </div>
                    {% else %}
                        {% for product in section.products %}
                            <custom-salla-product-card shadow-on-hover product="{{product}}" minimal></custom-salla-product-card>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>
 
